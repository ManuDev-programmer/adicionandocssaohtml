  body {
    margin: 50px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe U1", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans",
    "Helvetica Neue", sans-serif;
  }
  h3 {
    color: #6d3a9f;
    font-size: 18px;
    text-transform: uppercase;
  }
  table {
    width: 50%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th,
  td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #6d3a9f;
    color: #fff;
  }
  td:hover {
    background-color: rgb(159, 159, 231);
    color: #fff;
  }
